@using System.Security.Claims
@model PostDetailsViewModel

@{
    ViewData["Title"] = "Post Details";
} 

@if (Model.IsLikedByLoggedUser) 
{
    <p class="alert-dismissible">You liked this post.</p>  
} 

@if (TempData["OwnPostLikeNotAllowed"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["OwnPostLikeNotAllowed"] 
    </div>
} 

@if (TempData["PostLikeOnlyToFriendAllowed"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["PostLikeOnlyToFriendAllowed"]
    </div>
}

<h1 class="h2">@ViewData["Title"]</h1>
<p class="h5">@Model.AuthorName</p> 
<hr /> 

<p>@Model.Text</p> 

@if (Model.IsLoggedInUser == false)
{
    <form asp-controller="Posts" asp-action="Like" method="POST">
        <input type="hidden" name="postId" value="@Model.Id" />
        <input type="hidden" name="likingUserId" value="@User.FindFirst(ClaimTypes.NameIdentifier)?.Value" /> 

        <button type="submit" class="btn btn-primary">@(Model.IsLikedByLoggedUser == false ? "Like" : "Unlike")</button>
    </form>
} 

@if (Model.IsLoggedInUser == true)
{
    <div class="d-inline">
        <a class="btn btn-primary" asp-controller="Posts" asp-action="Edit" asp-route-postId="@Model.Id">Edit</a>
        <a class="btn btn-danger" asp-controller="Posts" asp-action="Delete" asp-route-postId="@Model.Id">Delete</a>
    </div>
}
