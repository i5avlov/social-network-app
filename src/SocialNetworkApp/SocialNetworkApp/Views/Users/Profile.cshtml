@using System.Security.Claims
@model UserProfileViewModel 

@{ 
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}"; 
}  

<p>User Profile</p> 
<h2 class="h3">@ViewData["Title"]</h2> 
<hr /> 

<div>
    <p><strong>City:</strong> @Model.City</p>
    <p><strong>Born:</strong> @Model.Birthdate</p>
</div>

@if (Model.IsLoggedInUser)
{
    <a class="btn btn-success" asp-controller="Posts" asp-action="Add">Create Post</a> 

    <h3 class="h4">Friend Invitations</h3>
    <div>
        @foreach (InvitationsListEntryViewModel inv in Model.WaitingInvitations)
        {
            <article>
                <div>@inv.Text</div>
                <div><strong>@inv.User.Name</strong></div>

                <div class="d-flex"> 
                    <form asp-controller="Invitations" asp-action="Accept" method="POST">
                        <input type="hidden" name="invitationId" value="@inv.Id" /> 
                        <button class="btn btn-success">Accept</button> 
                    </form>

                    <form asp-controller="Invitations" asp-action="Reject" method="POST" class="ms-2"> 
                        <input type="hidden" name="invitationId" value="@inv.Id" /> 
                        <button class="btn btn-danger">Reject</button>
                    </form>
                </div> 
            </article>
            <hr />
        }

        <a class="btn btn-success" asp-controller="" asp-action="" asp-route-userId="">All Received</a>
    </div> 
} 

@if (Model.IsLoggedInUser == false)
{
    <a 
        class="btn btn-success" 
        asp-controller="Invitations" 
        asp-action="Create" 
        asp-route-receiverUserId="@Model.Id"
    >Become Friends</a> 
    

    @if (TempData["InvitationSentMessage"] != null) 
    {
        <p class="bg-success text-white mt-2 p-2">@TempData["InvitationSentMessage"]</p> 
    }

    <a class="btn btn-success"
       asp-controller="Messages"
       asp-action="Chat"
       asp-route-otherUserId="@Model.Id"
    >Send Message</a> 
} 

<h3 class="h4">Posts</h3> 
<div> 
    @foreach (PostsListEntryViewModel post in Model.Posts)
    { 
        <article> 
            <p>@post.Text</p> 
        </article> 
        <hr /> 
    } 

    <a class="btn btn-success" asp-controller="Posts" asp-action="UserPosts" asp-route-userId="@Model.Id">All Posts</a> 
</div>
