@using System.Security.Claims
@model UserProfileViewModel 

@{ 
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}"; 
}  

<p>User Profile</p> 
<h2 class="h3">@ViewData["Title"]</h2> 
<hr /> 

<div>
    <p class="mb-1"><strong>City:</strong> @Model.City</p> 
    <p><strong>Born:</strong> @Model.Birthdate</p>
</div> 

@if (Model.IsLoggedInUser)
{ 
    <div>
        <a class="btn btn-success" asp-controller="Posts" asp-action="Add">Create Post</a> 
        <a class="btn btn-success" asp-controller="Users" asp-action="Index">Find Friends</a> 
    </div>
}

@if (Model.IsLoggedInUser)
{ 
    <div>
        <h3 class="h4 mt-4">Friend Invitations</h3>
     
        @if (Model.WaitingInvitations.Any())
        {
            @foreach (InvitationsListEntryViewModel inv in Model.WaitingInvitations)
            {
                    <article>
                        <div>@inv.Text</div>
                        <div><strong>@inv.User.Name</strong></div>

                        <div class="d-flex">
                            <form asp-controller="Invitations" asp-action="Accept" method="POST">
                                <input type="hidden" name="invitationId" value="@inv.Id" />
                                <button class="btn btn-success">Accept</button>
                            </form>

                            <form asp-controller="Invitations" asp-action="Reject" method="POST" class="ms-2">
                                <input type="hidden" name="invitationId" value="@inv.Id" />
                                <button class="btn btn-danger">Reject</button>
                            </form>
                        </div>
                    </article>
                    <hr />
            }

            <a class="" asp-controller="" asp-action="" asp-route-userId="">All Received</a>
        }
        else
        {
            <div>No new invitations.</div> 
        }
    </div> 
} 

@if (Model.IsLoggedInUser == false)
{ 
    @if (TempData["InvitationSentMessage"] != null)
    { 
        <div class="alert alert-success" role="alert">
            @TempData["InvitationSentMessage"]
        </div>
    } 

    @if (Model.IsFriendsWithUser ?? false)
    {
        <a class="btn btn-success"
           asp-controller="Messages"
           asp-action="Chat"
           asp-route-otherUserId="@Model.Id"
        >Send Message</a>
    }
    else
    {
        <a class="btn btn-success"
           asp-controller="Invitations"
           asp-action="Create"
           asp-route-receiverUserId="@Model.Id"
        >Become Friends</a> 
    }
} 

<div>
    <h3 class="h4 mt-4">Posts</h3>  

    @if (Model.Posts.Any()) 
    { 
        @foreach (PostsListEntryViewModel post in Model.Posts)
        { 
            <article> 
                <p>@post.Text</p> 
            </article> 
            <hr /> 
        } 

        <a class="" asp-controller="Posts" asp-action="UserPosts" asp-route-userId="@Model.Id">All Posts</a> 
    } 
    else
    {
        <div>No posts.</div> 
    }
</div> 

<div>
    <h3 class="h4 mt-4">Friends</h3> 

    @if (Model.Friends.Any()) 
    { 
        <div class="row"> 
            @foreach (UsersListEntryViewModel f in Model.Friends)
            {
            
                <article class="col-md-2 mb-2"> 
                    <div><strong>@f.Name</strong></div> 
                    <div>@f.City</div>
                    <a class=""
                       asp-controller="Users"
                       asp-action="Profile"
                       asp-route-userId="@f.Id"
                    >View</a> 
                    @if (Model.IsLoggedInUser)
                    {
                        <a class=""
                           asp-controller="Messages"
                           asp-action="Chat"
                           asp-route-otherUserId="@f.Id"
                        >Send Message</a>
                    }
                </article> 
            } 

            <a 
                class="" 
                asp-controller="Friendships" 
                asp-action="GetAll" 
                asp-route-userId="@Model.Id"
            >All Friends</a>
        </div>
    }
    else
    {
        <div>No friends yet.</div>
    }
</div> 


