@model IEnumerable<UsersListEntryViewModel> 

@{ 
    ViewData["Title"] = "All Users";
} 

<h2 class="h3">@ViewData["Title"]</h2> 

<div>
@foreach (var user in Model)
{
    <article>
        <h4 class="h5">@user.Name</h4> 
        <p>@user.City</p> 
        <a asp-controller="Users" asp-action="Profile" asp-route-userId="@user.Id">View profile</a>
    </article>
} 
</div>
